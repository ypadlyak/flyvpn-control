# Fly.io API token — create with: flyctl tokens create org -o personal
# (or copy access_token from ~/.fly/config.yml). Needs app create/destroy.
FLY_API_TOKEN=

# Fly organisation slug (most personal accounts: "personal").
FLY_ORG=personal

# Tailscale Admin API key — https://login.tailscale.com/admin/settings/keys
# Needs: ACL read/write, auth-key create, devices write.
TAILSCALE_API_KEY=

# --- Optional: Telegram bot -------------------------------------------------
# Create a bot via @BotFather, paste its token here to enable the bot.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat IDs allowed to control the VPN (you + wife).
# Get yours by messaging @userinfobot. REQUIRED if the bot is enabled.
TELEGRAM_ALLOWED_IDS=

# --- Optional tuning --------------------------------------------------------
VM_MEMORY=512

# Auto-teardown safety net (prevents a forgotten node billing forever):
#  - the node is auto-stopped after this many hours up (0 = never).
#  - a graceful container stop also tears the node down, and on startup any
#    leftover node from an unclean exit is destroyed.
MAX_NODE_HOURS=8
# How often (seconds) the max-age check runs.
MONITOR_INTERVAL=120
